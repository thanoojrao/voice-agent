# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
TWILIO_AUTH_TOKEN=

# Where "leave a message" emails go, and the Gmail account that sends them
OWNER_EMAIL=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Password for the /admin pages
ADMIN_PASSWORD=

# Your own number(s), comma-separated, like +15550100: they skip the per-caller daily
# limit so testing never locks you out. Optional.
OWNER_NUMBERS=

# Public HTTPS URL Twilio calls (your ngrok URL in development), no trailing slash
PUBLIC_BASE_URL=
